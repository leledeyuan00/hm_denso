<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:include filename="$(find denso_robot_description)/urdf/common.xacro" />
  <xacro:macro name="hm_denso_table" params="parent">
    <!-- hand link -->
    <link name="table_link">
      <!-- Default inertial for Gazebo/Ingnition - copy and edit block from 'common.xacro'
           to get more realistic behaviour-->
      <xacro:default_inertial/>
      <visual>
        <origin rpy="${pi/2} 0 ${pi/2}" xyz="-0.45 -0.75 0" />
        <geometry>
          <mesh scale="0.01 0.01 0.01" filename="package://hm_denso_description/meshes/hm_denso_robot/visual/table.dae" />
        </geometry>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 ${pi/2}" xyz="-0.45 -0.75 0" />
        <geometry>
          <mesh scale="0.01 0.01 0.01" filename="package://hm_denso_description/meshes/hm_denso_robot/collision/table.STL" />
        </geometry>
      </collision>
    </link>
    <!-- virtual link -->
    <link name="robot_base_link"/>

    <joint name="table_joint" type="fixed">
      <parent link="${parent}" />
      <child link="table_link" />
    </joint>
    <joint name= "table_end_joint" type="fixed">
      <parent link="table_link" />
      <child link="robot_base_link" />
      <origin xyz="0 0 0.7" />
    </joint>
  </xacro:macro>
</robot>